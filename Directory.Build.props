<Project>
  <!-- הגדרות משותפות לכל הפרויקטים. הפרויקט מכוון ל-.NET 8 (נדרש SDK ו-Runtime בגרסה 8.0.x). שינוי הגרסה כאן דורש לעדכן גם את חבילות 8.0.* -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
