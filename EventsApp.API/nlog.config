<?xml version="1.0" encoding="utf-8" ?>
<!-- הגדרות NLog: לאן נכתבים הלוגים, באיזה פורמט ומאיזו רמה. נטען אוטומטית בעלייה -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" throwConfigExceptions="false" internalLogLevel="Warn">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />  <!-- מאפשר את משתני ה-ASP.NET בפורמט -->
  </extensions>

  <!-- פורמט שורה: זמן | רמה | מזהה בקשה (CorrelationId) | מקור | הודעה | חריגה מלאה -->
  <variable name="line" value="${longdate}|${level:uppercase=true}|${scopeproperty:CorrelationId}|${logger:shortName=true}|${message} ${exception:format=tostring}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${line}" />   <!-- חלון השרת וגם הלוג של Render -->
    <target xsi:type="File" name="file" fileName="logs/events-${shortdate}.log"
            layout="${line}" encoding="utf-8" keepFileOpen="false"
            archiveEvery="Day" maxArchiveFiles="14" />                <!-- קובץ ליום, עד 14 ימים אחורה (תיקיית logs אינה נכנסת לגיט) -->
  </targets>

  <rules>
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console" final="true" />   <!-- הודעות הפעלה (פורט, סביבה) -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />                                     <!-- משתיק רעש של המסגרת, אזהרות ומעלה כן עוברות -->
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />                               <!-- משתיק רעש של HttpClient -->
    <logger name="*" minlevel="Info" writeTo="console,file" />                                     <!-- כל שאר הלוגים: Info ומעלה, לקונסול ולקובץ -->
  </rules>
</nlog>
